# Copia este archivo a .env.local y rellena los valores de tu proyecto Supabase.
#
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# URL pública de la aplicación (se usa para construir los enlaces de invitación).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Zona horaria usada para mostrar las fechas (por defecto Europe/Madrid).
NEXT_PUBLIC_TIMEZONE=Europe/Madrid